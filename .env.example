# Copy to .env next to compose.yaml. .env is ignored by git: it is per machine.

# Port the site answers on, on the homelab. The reverse proxy or the tunnel points here.
SITE_PORT=8081

# Web3Forms access key for the contact form. Public by design: it names the form, not an
# account. Empty falls back to opening the visitor's mail app.
WEB3FORMS_KEY=

# The media pipeline's manifest. Empty uses the committed one and the photos in public/media,
# which is the state until the pipeline is deployed.
MEDIA_MANIFEST_URL=

# Only for `docker compose --profile tunnel up -d`: the token of a Cloudflare tunnel
# (Zero Trust > Networks > Tunnels > the tunnel > Docker). Secret: never commit it.
TUNNEL_TOKEN=
